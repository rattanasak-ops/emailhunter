{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@0.26.0",
        "--isolated=true",
        "--headless=true",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers=true"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
